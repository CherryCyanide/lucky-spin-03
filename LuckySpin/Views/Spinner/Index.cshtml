@model LuckySpin.Models.Player
@{
    Layout = "LuckySpinLayout.cshtml";
}
<h2>Pick your Number</h2>
<!-- NOTE: This form collects the Player's Luck number and posts it to the SpinnerController's Index action -->
<form action="/Spinner/Index" method="post">
    <fieldset>
        <label>
            <input name="Name" placeholder="Player Name">
        </label>
        <label>
            <select name="Luck">
                <option selected disabled>Luck Number</option>
                <option>1</option>
                <option>2</option>
                <option>3</option>
                <option>4</option>
                <option>5</option>
                <option>6</option>
                <option>7</option>
                <option>8</option>
                <option>9</option>
            </select>
        </label>
    </fieldset>
    <input type="submit" value="Start the Game" />
</form>
